{
  "name": "sos-realty",
  "main": "worker.js",
  "compatibility_date": "2026-11-11",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sos-realty",
      "database_id": "adf92e8a-2b07-4372-bd0b-13e8186ef2ab"
    }
  ]
}
